{
  "id": "points-recognition",
  "contexts": ["household", "shared_space"],
  "name": "Points & Recognition",
  "version": "1.2.1",
  "description": "Award points to members for participation, attendance, and volunteering. Live leaderboard with per-period resets — a social currency system for org engagement.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "organization",
  "tags": ["org", "recognition", "points", "leaderboard", "engagement"],
  "data_access": {
    "reads": ["family.members", "family.groups"],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "preload": {
    "pr_settings": {"sql": "SELECT value FROM app_points_recognition__pr_settings WHERE key = 'officers_group_id'"},
    "pr_periods": {"sql": "SELECT * FROM app_points_recognition__pr_periods ORDER BY created_at DESC"},
    "pr_categories": {"sql": "SELECT * FROM app_points_recognition__pr_categories ORDER BY created_at ASC"},
    "pr_awards": {"sql": "SELECT * FROM app_points_recognition__pr_awards ORDER BY awarded_at DESC LIMIT 2000"}
  },
  "db_plaintext_columns": ["is_active"],
  "automation_actions": {
    "award": {
      "title": "Award points to a member",
      "description": "Give someone points in the open period when another app's event fires — a chore completed, a streak or habit milestone reached.",
      "params": {
        "member_id": { "type": "member", "label": "Who earns the points", "required": true },
        "points": { "type": "integer", "label": "Points", "required": true, "min": 1 },
        "note": { "type": "text", "label": "Note", "default": "Awarded by an automation" }
      },
      "dedupe": { "table": "pr_awards", "column": "source_event_id" },
      "steps": [
        {
          "op": "lookup",
          "table": "pr_periods",
          "where": { "is_active": "1" },
          "bind": { "period_id": "id" },
          "on_missing": "skip"
        },
        {
          "op": "insert",
          "table": "pr_awards",
          "values": {
            "id": "$uuid",
            "period_id": ":period_id",
            "category_id": "automation",
            "member_id": ":member_id",
            "points": ":points",
            "note": ":note",
            "awarded_by": "automation",
            "awarded_at": "$now",
            "source_event_id": "$event_id"
          }
        }
      ]
    }
  },
  "suggested_automations": [
    {
      "title": "Award points when a chore is completed",
      "description": "Every completed chore pays its point value into the open recognition period. Adjust the factor to change what a chore point is worth here.",
      "trigger_event": "chore.completed",
      "target_app_id": "points-recognition",
      "action_id": "award",
      "param_map": {
        "member_id": { "kind": "payload_field", "value": "member_id" },
        "points": { "kind": "scaled_field", "value": "points", "factor": 1 }
      }
    },
    {
      "title": "Award points for a streak milestone",
      "description": "Hitting a streak milestone awards one point per day of the streak, so the longer runs are worth more.",
      "trigger_event": "streak.milestone",
      "target_app_id": "points-recognition",
      "action_id": "award",
      "param_map": {
        "member_id": { "kind": "subject_id" },
        "points": { "kind": "scaled_field", "value": "days", "factor": 1 }
      }
    },
    {
      "title": "Award points for a habit milestone",
      "description": "A habit milestone awards one point per completion counted, recognising the quiet consistency nobody else sees.",
      "trigger_event": "habit.milestone",
      "target_app_id": "points-recognition",
      "action_id": "award",
      "param_map": {
        "member_id": { "kind": "subject_id" },
        "points": { "kind": "scaled_field", "value": "count", "factor": 1 }
      }
    },
    {
      "title": "Award points for finishing a book",
      "description": "Finishing a book in the reading log pays points into the open recognition period — five per book by default, adjust to taste. The event names no title, so neither does the award.",
      "trigger_event": "reading.book_finished",
      "target_app_id": "points-recognition",
      "action_id": "award",
      "param_map": {
        "member_id": { "kind": "payload_field", "value": "member_id" },
        "points": { "kind": "const", "value": 5 }
      }
    },
    {
      "title": "Award a point when a task is completed",
      "description": "Every completed task pays one point to its assignee — a light nudge that makes finishing visible.",
      "trigger_event": "task.completed",
      "target_app_id": "points-recognition",
      "action_id": "award",
      "param_map": {
        "member_id": { "kind": "payload_field", "value": "assignee_id" },
        "points": { "kind": "const", "value": 1 }
      }
    }
  ],
  "glance": {
    "source": {
      "kind": "sql",
      "query": "SELECT COALESCE(SUM(a.points), 0) AS value FROM app_points_recognition__pr_awards a JOIN app_points_recognition__pr_periods p ON p.id = a.period_id AND p.is_active = 1 WHERE a.member_id = :me LIMIT 1"
    },
    "display": {
      "template": "stat",
      "value": "value",
      "label": "points this period",
      "empty_hides": true
    }
  },
  "publishes": [
    "recognition.award_given"
  ],
  "publish_acls": {
    "recognition.award_given": {
      "require_group_setting": {
        "settings_table": "pr_settings",
        "settings_key": "officers_group_id"
      }
    }
  },
  "row_policies": {
    "pr_settings": { "kind": "app_config" },
    "pr_awards": {
      "kind": "owner_or_visibility",
      "member_column": "awarded_by",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "write_privileged_only": true,
      "privileged_groups": [{ "settings_table": "pr_settings", "settings_key": "officers_group_id" }]
    },
    "pr_categories": {
      "kind": "owner_or_visibility",
      "member_column": "created_by",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "write_privileged_only": true,
      "privileged_groups": [{ "settings_table": "pr_settings", "settings_key": "officers_group_id" }]
    },
    "pr_periods": {
      "kind": "owner_or_visibility",
      "member_column": "created_by",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"],
      "write_privileged_only": true,
      "privileged_groups": [{ "settings_table": "pr_settings", "settings_key": "officers_group_id" }]
    }
  },
  "admin_config": {
    "settings_table": "pr_settings",
    "keys": ["officers_group_id"]
  },
  "icon": "⭐",
  "member_references": {
    "pr_periods": { "column": "created_by", "on_removed": "keep" },
    "pr_categories": { "column": "created_by", "on_removed": "keep" },
    "pr_awards": [
      { "column": "member_id", "on_removed": "delete" },
      { "column": "awarded_by", "on_removed": "keep" }
    ]
  },
  "resource_limits": { "max_db_bytes": 52428800 },
  "nav": { "label": "Points" },
  "widget": { "label": "Top Members", "size": "small" },
  "ai_access": {
    "allowed": true,
    "mode": "read",
    "db_exports": ["current_standings", "member_history"]
  }
}
